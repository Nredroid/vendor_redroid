cc_library_shared {
    name: "gralloc.gbm",

    srcs: [
        "gralloc_gbm.cpp",
        "gralloc.cpp",
    ],

    shared_libs: [
        "libdrm",
        "liblog",
        "libcutils",
        "libhardware",
    ] + ["libgbm_mesa"],

    export_include_dirs: ["."],

    relative_install_path: "hw",
    proprietary: true,

}

cc_library_shared {
    name: "libgralloc_drm",

    export_include_dirs: ["."],

    proprietary: true,

}
